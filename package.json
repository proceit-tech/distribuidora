{
  "name": "distribuidora-mvp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.build.json",
    "typecheck:casos": "next typegen && tsc --noEmit -p scripts/casos-clientes/tsconfig.json",
    "lint:app": "eslint app components lib types instrumentation.ts next.config.ts --ignore-pattern \"**/*.casos.ts\" --ignore-pattern \"**/*.casos.tsx\" --ignore-pattern lib/clientes/contador-casos.ts",
    "lint:casos": "eslint \"lib/**/*.casos.ts\" lib/clientes/contador-casos.ts scripts/casos-clientes",
    "casos:limpiar": "node -e \"require('fs').rmSync('.tmp-casos',{recursive:true,force:true})\"",
    "casos:compilar": "npm run casos:limpiar && next typegen && tsc -p scripts/casos-clientes/tsconfig.json",
    "casos": "npm run casos:compilar && node scripts/casos-clientes/run.js",
    "verificar:dependencias": "bash scripts/verificar-separacion.sh dependencias",
    "verificar:standalone": "bash scripts/verificar-separacion.sh standalone"
  },
  "dependencies": {
    "next": "16.2.6",
    "pg": "^8.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  }
}
