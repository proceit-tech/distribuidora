# --- Docker / VM (PROCEIT) ---
APP_NAME=distribuidora
APP_DOMAIN=distribuidora-dev.proceit.net
APP_VERSION=latest
APP_PORT=3000
APP_MEMORY_LIMIT=512m

# --- Aplicação ---
# Banco no PostgreSQL compartilhado da VM (rede "db"): host "postgres"
DATABASE_URL=postgresql://<usuario>:<senha>@postgres:5432/<banco>
SESSION_COOKIE_NAME=
DEMO_MODE=
